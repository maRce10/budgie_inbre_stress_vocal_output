print_kable <- function(x) {
kb <- kable(x, row.names = TRUE, digits = 4, "html")
kb <- kable_styling(kb, bootstrap_options = c("striped", "hover", "condensed", "responsive"))
scroll_box(kb, width = "100%")
}
